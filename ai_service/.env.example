# Copy to ai_service/.env for local runs. Non-secret settings only.
# API keys come from the macOS Keychain through `make ai-dev`; store them with `make keys-add`.
BASETEN_BASE_URL=https://inference.baseten.co/v1
BASETEN_MODEL=meta-models/muse-spark-open-1026
FIREWORKS_BASE_URL=https://api.fireworks.ai/inference/v1
